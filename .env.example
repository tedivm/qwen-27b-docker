# HuggingFace token (required for gated models)
HF_TOKEN=your_token_here

# Server configuration
# PORT=1234
# SERVED_MODEL_NAME=qwen3.8-27b
# MAX_MODEL_LEN=250000
# MAX_NUM_SEQS=3
# MAX_NUM_BATCHED_TOKENS=8192
# GPU_MEMORY_UTIL=0.92
# NUM_SPECULATIVE_TOKENS=3
# KV_CACHE_DTYPE=fp8

# Generation parameters
# TEMPERATURE=0.6
# TOP_P=0.95
# TOP_K=20
# MIN_P=0.0
# PRESENCE_PENALTY=0
# REPETITION_PENALTY=1.0
# REASONING_PARSER=qwen3
# TOOL_CALL_PARSER=qwen3_coder
# AUTO_TOOL_CHOICE=1
# CHAT_TEMPLATE= (defaults to model's built-in template)
# - CHAT_TEMPLATE=/usr/local/bin/qwen3.8-froggeric.jinja
# CHAT_TEMPLATE_PRESERVE_THINKING=true
# CHAT_TEMPLATE_ENABLE_THINKING=true

# vLLM tuning
# VLLM_ALLREDUCE_USE_FLASHINFER=0
# PER_REQUEST_SPEC_DECODE=none
# PERFORMANCE_MODE=interactivity
# GDN_PREFILL_BACKEND=triton
# KDA_PREFILL_BACKEND=
# KDA_DECODE_BACKEND=flashinfer

# OpenTelemetry (uncomment to enable)
# OTEL_SERVICE_NAME=vllm-qwen38
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_INSECURE=true
